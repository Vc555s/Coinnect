# Copy to backend/.env to override defaults. Everything is optional.

# SQLite by default (backend/data/coinnect.db). Any SQLAlchemy URL works, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/coinnect   (pip install psycopg)
# DATABASE_URL=

# Token signing key. If unset, one is generated and kept in backend/data/.secret_key.
# SECRET_KEY=

# Seed the demo community on an empty database (password for all demo accounts: demo1234)
SEED_DEMO=true
STARTING_BALANCE=10
TOKEN_TTL_HOURS=168
CORS_ORIGINS=http://localhost:5173

# Optional: pin every receipt to IPFS through a Kubo-compatible RPC endpoint,
# e.g. a local `ipfs daemon` (http://127.0.0.1:5001) or a pinning service's RPC API.
# IPFS_RPC_URL=
# IPFS_RPC_TOKEN=
# IPFS_GATEWAY=https://ipfs.io/ipfs/
